# ---- Database (Supabase Postgres + pgvector) ----
# Get this from: Supabase Dashboard -> Project Settings -> Database ->
# "Connection string" -> URI. Replace [YOUR-PASSWORD] with your DB password.
#
# Transaction pooler (port 6543) — recommended for serverless/Render. Prepared
# statements are disabled automatically for this host, so it just works:
DATABASE_URL=postgresql://postgres.<ref>:[YOUR-PASSWORD]@aws-0-<region>.pooler.supabase.com:6543/postgres
# Or the direct/session connection (port 5432) if you prefer:
# DATABASE_URL=postgresql://postgres.<ref>:[YOUR-PASSWORD]@aws-0-<region>.pooler.supabase.com:5432/postgres
#
# The pgvector extension is enabled automatically on first boot (init_db runs
# CREATE EXTENSION IF NOT EXISTS vector). Supabase already ships pgvector.

# ---- OpenAI / LLM ----
OPENAI_API_KEY=sk-your-key-here
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536
CHAT_MODEL=gpt-4o-mini

# ---- App ----
APP_NAME=Chatbot Waiter
RESTAURANT_NAME=Demo Bistro
CURRENCY=$
# Comma separated list, or * for all (demo only)
CORS_ORIGINS=*
# Secret used to sign session tokens
SESSION_SECRET=change-me-in-production
# Staff token to access kitchen/reports/admin pages. Leave blank to DISABLE
# protection (demo mode). Set a strong random value in production.
STAFF_TOKEN=

# ---- UPI payment (display QR) ----
# Global default payee VPA/name. Each restaurant can override these at upload.
# UPI is India-only; currency is always INR regardless of display CURRENCY.
UPI_VPA=yourname@okbank
UPI_PAYEE_NAME=Your Restaurant
UPI_CURRENCY=INR

# ---- Retrieval ----
TOP_K=5
CHUNK_SIZE=800
CHUNK_OVERLAP=120
